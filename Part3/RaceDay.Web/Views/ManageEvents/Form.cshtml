@model EventFormViewModel
@{
    var isEdit = Model.EventId.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "New event";
}

<a asp-action="Index" class="rd-back"><i class="bi bi-arrow-left"></i> My events</a>

<div class="rd-card mt-2">
    <p class="rd-eyebrow">Organiser</p>
    <h1 class="rd-title">@(isEdit ? "Edit event" : "Create a new event")</h1>

    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="EventId" />

        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Running">Running</option>
                    <option value="Walking">Walking</option>
                    <option value="Cycling">Cycling</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-5 mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartPoint" class="form-label"></label>
                <input asp-for="StartPoint" class="form-control" />
                <span asp-validation-for="StartPoint" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EndPoint" class="form-label"></label>
                <input asp-for="EndPoint" class="form-control" />
                <span asp-validation-for="EndPoint" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="RouteDescription" class="form-label"></label>
            <textarea asp-for="RouteDescription" rows="2" class="form-control"></textarea>
        </div>

        <div class="mb-4">
            <label asp-for="Banner" class="form-label"></label>
            @if (isEdit && Model.HasBanner)
            {
                <div class="mb-2">
                    <img class="rd-banner-preview" src="@Url.Action("EventBanner", "Media", new { id = Model.EventId })" alt="Current banner" />
                    <div class="form-text">Current banner. Choose a new image to replace it.</div>
                </div>
            }
            <input asp-for="Banner" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <div class="form-text">JPG, PNG or WebP, up to 5 MB. Stored securely in Azure Blob Storage.</div>
            <span asp-validation-for="Banner" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn rd-btn-accent">@(isEdit ? "Save changes" : "Create event")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
