@model HomeIndexViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Type)
        || Model.MinDistanceKm.HasValue || Model.MaxDistanceKm.HasValue;
}

<section class="rd-hero mb-4">
    <p class="rd-eyebrow">Find your next start line</p>
    <h1 class="rd-display">Upcoming events</h1>
    <p class="mb-0">Runs, walks and cycle rides across South Africa. Filter by type, name, place or distance.</p>
</section>

<form method="get" asp-action="Index" class="rd-card mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="Search" class="form-label">Name or location</label>
            <input asp-for="Search" class="form-control" placeholder="e.g. Soweto" />
        </div>
        <div class="col-md-2">
            <label asp-for="Type" class="form-label">Event type</label>
            <select asp-for="Type" class="form-select">
                <option value="">All types</option>
                <option value="Running">Running</option>
                <option value="Walking">Walking</option>
                <option value="Cycling">Cycling</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="MinDistanceKm" class="form-label"></label>
            <input asp-for="MinDistanceKm" type="number" step="0.1" min="0" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="MaxDistanceKm" class="form-label"></label>
            <input asp-for="MaxDistanceKm" type="number" step="0.1" min="0" class="form-control" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn rd-btn-accent flex-fill">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters">Clear</a>
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="rd-card text-center">
        <i class="bi bi-calendar-x rd-big-icon"></i>
        <h2 class="rd-card-title">@(hasFilters ? "No events match your filters" : "No upcoming events yet")</h2>
        <p class="text-muted mb-0">@(hasFilters ? "Try widening your search or clearing the filters." : "Check back soon: organisers add new events all the time.")</p>
    </div>
}
else
{
    <p class="text-muted">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events") found</p>
    <div class="row g-4">
        @foreach (var item in Model.Events)
        {
            <div class="col-md-6 col-xl-4">
                <partial name="_EventCard" model="item" />
            </div>
        }
    </div>
}
