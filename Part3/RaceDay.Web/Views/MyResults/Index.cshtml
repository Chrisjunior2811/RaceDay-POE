@model List<ResultDto>
@{
    ViewData["Title"] = "My results";
    var finished = Model.Count(r => r.Status == "Finished");
}

<section class="rd-hero mb-4">
    <p class="rd-eyebrow">Your race history</p>
    <h1 class="rd-display">My results</h1>
    <p class="mb-0">Results appear here as soon as an organiser captures them.</p>
</section>

@if (Model.Count == 0)
{
    <div class="rd-card text-center">
        <i class="bi bi-trophy rd-big-icon"></i>
        <h2 class="rd-card-title">No results yet</h2>
        <p class="text-muted">Once an organiser records your finish, it will show up here.</p>
        <a asp-controller="MyEnrolments" asp-action="Index" class="btn rd-btn-accent">See my enrolments</a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6"><div class="rd-stat"><span class="rd-stat-number">@Model.Count</span><span class="rd-stat-label">Events recorded</span></div></div>
        <div class="col-sm-6"><div class="rd-stat"><span class="rd-stat-number">@finished</span><span class="rd-stat-label">Finishes</span></div></div>
    </div>

    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.EventName</strong></td>
                            <td>@Format.ShortDate(item.EventDate)</td>
                            <td>@item.CategoryName</td>
                            <td class="rd-time">@Format.Duration(item.FinishTimeSeconds)</td>
                            <td>
                                @if (item.Status != "Finished")
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                                else if (item.FinishPosition.HasValue)
                                {
                                    <strong>@Format.Ordinal(item.FinishPosition.Value)</strong>
                                    <span class="text-muted">out of @item.TotalFinishers finishers</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not recorded</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
