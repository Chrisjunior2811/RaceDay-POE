@model ResultsPageViewModel
@{
    ViewData["Title"] = "Results";
}

<a asp-controller="ManageEvents" asp-action="Index" class="rd-back"><i class="bi bi-arrow-left"></i> My events</a>

<div class="mt-2 mb-3">
    <p class="rd-eyebrow mb-0">Results for</p>
    <h1 class="rd-title mb-0">@Model.Event.EventName</h1>
    <span class="text-muted">@Format.DateAndTime(Model.Event.EventDate) - @Model.Event.Location</span>
</div>

<div class="alert alert-info">
    Enter each participant's finish time as <strong>hh:mm:ss</strong> (for example 01:45:30). A saved result is visible to the participant straight away and cannot be edited.
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="rd-card text-center">
        <i class="bi bi-people rd-big-icon"></i>
        <h2 class="rd-card-title">No enrolled participants</h2>
        <p class="text-muted mb-0">There is nobody to record results for yet.</p>
    </div>
}
else
{
    foreach (var item in Model.Enrolments)
    {
        Model.ResultsByEnrolment.TryGetValue(item.EnrolmentId, out var recorded);

        <div class="rd-card mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div>
                    <strong>@item.ParticipantName</strong>
                    <span class="text-muted"> - @item.CategoryName - Bib @item.BibNumber</span>
                </div>
                <partial name="_StatusBadge" model="item.PaymentStatus" />
            </div>

            @if (recorded is not null)
            {
                <div class="rd-recorded">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    Result saved:
                    <strong class="rd-time">@Format.Duration(recorded.FinishTimeSeconds)</strong>
                    @if (recorded.FinishPosition.HasValue)
                    {
                        <span> - @Format.Ordinal(recorded.FinishPosition.Value) overall</span>
                    }
                    @if (recorded.CategoryPosition.HasValue)
                    {
                        <span> - @Format.Ordinal(recorded.CategoryPosition.Value) in category</span>
                    }
                    <span class="badge bg-secondary ms-1">@recorded.Status</span>
                </div>
            }
            else
            {
                <form asp-action="Capture" asp-route-eventId="@Model.Event.EventId" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="EnrolmentId" value="@item.EnrolmentId" />
                    <div class="col-md-3">
                        <label class="form-label small">Finish time</label>
                        <input type="text" name="FinishTime" class="form-control" placeholder="hh:mm:ss" autocomplete="off" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Overall position</label>
                        <input type="number" name="FinishPosition" min="1" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Category position</label>
                        <input type="number" name="CategoryPosition" min="1" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Status</label>
                        <select name="Status" class="form-select">
                            <option value="Finished">Finished</option>
                            <option value="DNF">Did not finish</option>
                            <option value="DSQ">Disqualified</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn rd-btn-accent w-100">Save result</button>
                    </div>
                </form>
            }
        </div>
    }
}
