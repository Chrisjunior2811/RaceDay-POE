@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="rd-card text-center mx-auto" style="max-width: 560px">
    <i class="bi bi-flag rd-big-icon"></i>
    <p class="rd-eyebrow">Error @Model.Code</p>
    <h1 class="rd-title">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    <a class="btn rd-btn-accent" asp-controller="Home" asp-action="Index">Back to the start line</a>
</div>
