@model EventDto

<div class="card rd-event-card h-100">
    @if (Model.HasBanner)
    {
        <img class="rd-banner" src="@Url.Action("EventBanner", "Media", new { id = Model.EventId })" alt="Banner for @Model.EventName" />
    }
    else
    {
        <img class="rd-banner" src="~/img/event-placeholder.svg" alt="RaceDay event" />
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge rd-type rd-type-@Model.EventType.ToLowerInvariant()"><i class="bi @Format.TypeIcon(Model.EventType)"></i> @Model.EventType</span>
            <span class="rd-countdown">@Format.DaysUntil(Model.EventDate)</span>
        </div>
        <h2 class="rd-card-title">@Model.EventName</h2>
        <ul class="list-unstyled rd-meta mb-3">
            <li><i class="bi bi-calendar-event"></i> @Format.DateAndTime(Model.EventDate)</li>
            <li><i class="bi bi-geo-alt"></i> @Model.Location</li>
            @if (Model.DistanceKm.HasValue)
            {
                <li><i class="bi bi-signpost-split"></i> @Model.DistanceKm.Value.ToString("0.##") km</li>
            }
        </ul>
        <a class="btn rd-btn-accent mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View event and enrol</a>
    </div>
</div>
