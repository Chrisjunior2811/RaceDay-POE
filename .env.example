# Copy this file to ".env" to override the defaults used by docker-compose.yml
# SA_PASSWORD must be a strong SQL Server password (8+ characters with upper, lower, digit and symbol).
SA_PASSWORD=RaceDay_Passw0rd!

# Change the signing key before any real deployment (at least 32 characters).
JWT_KEY=RaceDay-Docker-Signing-Key-Change-Me-Please-2026!

# Code organisers must enter when they register.
ORGANISER_CODE=RACEDAY-ORGANISER-2026

# Leave this commented out to use the Azurite emulator started by docker compose.
# To use a real Azure Storage account, paste its connection string here (Azure portal > Storage account > Access keys).
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
