@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
    var eventId = (int)ViewData["EventId"]!;
}

<a asp-action="Index" asp-route-eventId="@eventId" class="rd-back"><i class="bi bi-arrow-left"></i> Categories</a>

<div class="rd-card mt-2 mx-auto" style="max-width: 640px">
    <p class="rd-eyebrow">Organiser</p>
    <h1 class="rd-title">Edit category</h1>

    <form asp-action="Edit" asp-route-eventId="@eventId" asp-route-id="@Model.CategoryId" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="EntryFee" class="form-label"></label>
                <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="EntryFee" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="MaxParticipants" class="form-label"></label>
                <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                <span asp-validation-for="MaxParticipants" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn rd-btn-accent">Save changes</button>
            <a asp-action="Index" asp-route-eventId="@eventId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
