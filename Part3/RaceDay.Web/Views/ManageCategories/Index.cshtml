@model CategoriesPageViewModel
@{
    ViewData["Title"] = "Categories";
}

<a asp-controller="ManageEvents" asp-action="Index" class="rd-back"><i class="bi bi-arrow-left"></i> My events</a>

<div class="mt-2 mb-3">
    <p class="rd-eyebrow mb-0">Categories for</p>
    <h1 class="rd-title mb-0">@Model.Event.EventName</h1>
    <span class="text-muted">@Format.DateAndTime(Model.Event.EventDate) - @Model.Event.Location</span>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="rd-card">
            <h2 class="rd-card-title">Existing categories</h2>
            @if (Model.Categories.Count == 0)
            {
                <p class="text-muted mb-0">No categories yet. Add the first one using the form.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table align-middle mb-0">
                        <thead><tr><th>Category</th><th>Distance</th><th>Fee</th><th>Limit</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Categories)
                            {
                                <tr>
                                    <td><strong>@item.CategoryName</strong></td>
                                    <td>@item.DistanceKm.ToString("0.##") km</td>
                                    <td>@Format.Rand(item.EntryFee)</td>
                                    <td>@item.MaxParticipants</td>
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-eventId="@Model.Event.EventId" asp-route-id="@item.CategoryId">Edit</a>
                                        <form asp-action="Delete" asp-route-eventId="@Model.Event.EventId" asp-route-id="@item.CategoryId" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="rd-card">
            <h2 class="rd-card-title">Add a category</h2>
            <p class="text-muted small">For example: 5km, 10km, 21km, Under 20 or Senior.</p>
            <form asp-action="Add" asp-route-eventId="@Model.Event.EventId" method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="Form.CategoryName" class="form-label"></label>
                    <input asp-for="Form.CategoryName" class="form-control" />
                    <span asp-validation-for="Form.CategoryName" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Form.DistanceKm" class="form-label"></label>
                        <input asp-for="Form.DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="Form.DistanceKm" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Form.EntryFee" class="form-label"></label>
                        <input asp-for="Form.EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Form.EntryFee" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Form.MaxParticipants" class="form-label"></label>
                        <input asp-for="Form.MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Form.MaxParticipants" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn rd-btn-accent w-100">Add category</button>
            </form>
        </div>
    </div>
</div>
